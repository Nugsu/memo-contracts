# Copy this file to .env and fill in your own values.
# NEVER commit a real private key. Use a dedicated, throwaway testnet wallet.

# Private key of the MetaMask account used to deploy (no 0x prefix is fine).
PRIVATE_KEY=0xyour_private_key_here

# Sepolia JSON-RPC endpoint
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Etherscan API key, needed only for `hardhat verify`
ETHERSCAN_API_KEY=
